<?xml version="1.0" encoding="utf-8"?>
<!--
  JellyWrist network configuration (GAP-008, decided 2026-08-08).

  Cleartext traffic is ALLOWED, in debug as well as release: this is a product
  requirement — the app determines the scheme itself (probe https:// then http://,
  owner decision of 2026-08-08, see UrlNormalizer.candidates), and self-hosted
  Jellyfin servers in plain HTTP on the LAN (`http://…:8096`, PLAN.md §3.1) are a
  first-class use case. Android does not permit restricting cleartext to arbitrary
  hosts entered at runtime (`domain-config` only accepts names known at compile
  time): the permission is therefore global — a documented, accepted trade-off.

  The probe order systematically favors HTTPS: cleartext is used only if
  no HTTPS candidate responds.

  TLS verification is NEVER weakened (DEC-006): HTTPS is validated against
  system authorities; opt-in pinning of a self-signed certificate is handled at
  runtime by PinningTrustManager, scoped to the app's HTTP client.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
